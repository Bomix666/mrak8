# Copy this file to `.env` in the same directory and fill in real values.
# .env is never committed — add it to .gitignore.

# --- Core -------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Europe/Amsterdam

# --- Shop ---------------------------------------------------------------
# ISO 4217 code of the one currency prices are entered in (RUB, USD, EUR…).
# Shown on the storefront and stamped on every order and payment.
SHOP_CURRENCY=USD

# --- Frontend / CORS ----------------------------------------------------
# Django serves the storefront itself, so the site and the API share one
# origin and nothing needs listing here. Only add origins if you host the
# frontend somewhere else.
FRONTEND_BASE_URL=http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# --- Database (leave blank to use local SQLite) ------------------------
# POSTGRES_DB=mrak8
# POSTGRES_USER=mrak8
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# --- Payments ------------------------------------------------------------
# One of: manual_test | yookassa | tbank
# Keep manual_test until a real provider is implemented in
# apps/payments/services.py — see the TODOs there.
PAYMENT_PROVIDER=manual_test

# YooKassa (fill in when PAYMENT_PROVIDER=yookassa)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# T-Bank / Tinkoff Acquiring (fill in when PAYMENT_PROVIDER=tbank)
TBANK_TERMINAL_KEY=
TBANK_SECRET_KEY=

# --- Email ---------------------------------------------------------------
# Defaults to console output. Point at a real backend to send real email,
# e.g. django.core.mail.backends.smtp.EmailBackend, plus EMAIL_HOST etc.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@mrak8.com

# --- First admin user (used by `python manage.py createsuperuser --noinput`) --
# Do NOT put a real production password here in source control.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@mrak8.com
DJANGO_SUPERUSER_PASSWORD=change-me-locally
